{
  "manifest_version": 3,
  "name": "Customer Purchase Info for Messenger",
  "version": "0.4.0",
  "description": "Shows customer purchase details in the Meta Business Suite inbox panel.",
  "permissions": [
    "storage",
    "scripting"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://business.facebook.com/latest/inbox/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://business.facebook.com/latest/inbox/*"
      ],
      "js": [
        "inbox-voice-main.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "host_permissions": [
    "https://api.manychat.com/*",
    "https://baserow.dd-herbs.com/*",
    "https://yxch9n4n6e.execute-api.ap-southeast-1.amazonaws.com/*",
    "https://7n881aguj8.execute-api.ap-southeast-1.amazonaws.com/*",
    "http://localhost:8000/*",
    "https://ec2.full2house.com/*",
    "https://www.facebook.com/plugins/*",
    "https://*.fbcdn.net/*",
    "https://cdn.fbsbx.com/*",
    "https://generativelanguage.googleapis.com/*"
  ]
}
